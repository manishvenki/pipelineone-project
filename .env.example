# ========================================================
# Pipeline One — Environment Configuration Template
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Application Authentication
# Secret used to sign JWT tokens (minimum 32 characters recommended)
JWT_SECRET=replace_with_a_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Credential Encryption
# 32-byte hexadecimal string for AES-256-GCM encryption of integration tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PostgreSQL Configuration (Primary Relational Store)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pipeline_one
# Or discrete parameters:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=pipeline_one

# MongoDB Atlas Configuration (Secondary Cloud Document Store)
# Optional: used for flexible raw project scans and diagnostic telemetry
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pipeline_one?retryWrites=true&w=majority

# GitHub Integration (Phase 1)
# Create OAuth application at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/integrations/github/callback

# Docker Hub Integration & Containerization Engine (Phase 2)
# Docker build execution timeout in milliseconds (default: 10 minutes)
DOCKER_BUILD_TIMEOUT_MS=600000
DOCKER_LOGS_DIR=storage/build-logs

# Jenkins Server Integration Security (Phase 2)
# Set to 'true' ONLY in local development when targeting localhost:8080.
# Keep 'false' in production to enforce strict SSRF protection against internal subnets and cloud metadata.
ALLOW_PRIVATE_JENKINS=false

# Vercel Integration (Phase 2)
# Optional for OAuth 2.0 flow (PAT authentication works without OAuth client credentials)
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_REDIRECT_URI=http://localhost:5000/api/integrations/vercel/callback

# Storage Limits
MAX_UPLOAD_SIZE_MB=50
